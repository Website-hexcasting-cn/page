---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const { title } = Astro.props;
---
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#914b97" />
		<title>{title}</title>
	</head>
	<body>
        <Header />
		<slot />
        <Footer />
	</body>
</html>
<script>
	// 全局：把页面正文里的 iota:... 自动渲染为图案/图标（md 渲染的文章页同样生效），
	// 同时渲染 <IotaPattern> 组件输出的占位 span。
	import { autoRenderIotas, renderIotaSpan } from '../lib/iotaRender';
	function run() {
		try {
			autoRenderIotas(document.body);
			document.querySelectorAll('.iota-pattern[data-iota]').forEach((el) => renderIotaSpan(el));
		} catch (e) { console.warn('[iota] 自动渲染失败', e); }
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', run);
	} else {
		run();
	}
</script>
<style>
    body {
        background-color: #914b97;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }

    body > main {
        flex: 1;
        min-height: 0;
    }
</style>

<style is:global>
    :root {
        /* 间距系统 */
        --space-xs: 4px;
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 24px;
        --space-xl: 40px;
        --space-2xl: 64px;

        /* 主色 */
        --color-primary: #914b97;
        --color-primary-dark: #6f3a74;
        --color-primary-light: #b06ab5;
        --color-primary-soft: #e8d5ea;

        /* 中性色 */
        --color-text: #2c2c2c;
        --color-text-muted: #666;
        --color-text-faint: #999;
        --color-bg: #ffffff;
        --color-bg-soft: #f4f3f0;
        --color-border: #e8e5df;

        /* 容器 */
        --container-max: 1200px;
        --container-narrow: 760px;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        /* 阴影 */
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.12);
        --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.18);

        /* 过渡 */
        --transition-fast: 0.15s ease;
        --transition-base: 0.2s ease;

        /* 断点（参考用，实际在媒体查询中硬编码） */
        --bp-tablet: 768px;
        --bp-desktop: 1024px;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        line-height: 1.75;
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        * {
            animation-duration: 0.01ms !important;
            transition-duration: 0.01ms !important;
        }
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
            "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial,
            sans-serif;
        color: var(--color-text);
        /* 顶部留出 sticky header 的空间由各页面自行处理 */
    }

    a {
        color: var(--color-primary);
        transition: color var(--transition-base);
    }

    img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    /* 可访问性：键盘焦点样式 */
    :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* iota 内联图案 */
    .iota-pattern {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        vertical-align: middle;
        margin: 0 2px;
    }
    .iota-pattern svg {
        display: block;
        max-width: none;
        height: 1.6em;
        width: auto;
    }
    .iota-pattern .iota-error {
        color: #ff8f8f;
        font-style: italic;
    }
    /* Iota 类型样式（黑体） */
    .iota-pattern .iota-double {
        color: #7fff7f;
        font-family: "Noto Sans SC", "Microsoft YaHei", "黑体", "SimHei", sans-serif;
        font-weight: 700;
        white-space: nowrap;
    }
    .iota-pattern .iota-vec {
        color: #ff6b6b;
        font-family: "Noto Sans SC", "Microsoft YaHei", "黑体", "SimHei", sans-serif;
        font-weight: 700;
        white-space: nowrap;
    }
    .iota-pattern .iota-null {
        color: #9e9e9e;
        font-family: "Noto Sans SC", "Microsoft YaHei", "黑体", "SimHei", sans-serif;
        font-weight: 700;
    }
    .iota-pattern .iota-garbage {
        color: #8a8a8a;
        font-family: monospace;
        letter-spacing: 1px;
    }
    .iota-pattern .iota-list {
        color: #aa00aa;
        font-family: "Noto Sans SC", "Microsoft YaHei", "黑体", "SimHei", sans-serif;
    }
    .iota-pattern .iota-label {
        color: #b39ddb;
        font-family: monospace;
        font-size: 0.85em;
        padding: 0 4px;
        border: 1px solid #6d4c8a;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.2);
    }
    /* 列表内图案：与文本同高、紧凑内联（不堆叠） */
    .iota-list {
        white-space: nowrap;
    }
    .iota-list svg {
        display: inline-block;
        height: 1.05em;
        width: auto;
        vertical-align: middle;
        margin: 0 1px;
    }
    .iota-list .iota-comma {
        color: #aa00aa;
        margin: 0 2px;
        font-weight: 700;
    }
</style>
