---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/baseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
---
<BaseLayout title="文章——阿卡夏图书馆">
    <main>
        <section class="page-head">
            <h1>文章</h1>
            <p>咒法学（Hex Casting）相关的教程与资料。</p>
            <div class="hero-line"></div>
        </section>

        {
            posts.length > 0 ? (
                <div class="post-grid">
                    {posts.map((post, index) => (
                        <article class="post-card">
                            <div class="post-card-accent" style={`background: hsl(${280 + index * 30}, 45%, 55%)`} />
                            <div class="post-card-body">
                                <div class="post-card-meta-top">
                                    <time class="post-card-date">{post.data.date.toLocaleDateString('zh-CN')}</time>
                                    <span class="post-card-dot">·</span>
                                    <span class="post-card-label">文章</span>
                                </div>
                                <h2 class="post-card-title">
                                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                                </h2>
                                {post.data.description && <p class="post-card-excerpt">{post.data.description}</p>}
                                <a href={`/posts/${post.id}/`} class="post-card-link">继续阅读 <span class="arrow" aria-hidden="true">→</span></a>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="empty-state">
                    <h2>还没有文章</h2>
                    <p>在 <code>src/content/posts/</code> 目录下创建 <code>.md</code> 文件即可开始写作。</p>
                </div>
            )
        }
    </main>
</BaseLayout>

<style>
    main {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: var(--space-xl) var(--space-lg) var(--space-2xl);
        width: 100%;
    }

    .page-head {
        text-align: center;
        padding: var(--space-md) 0 var(--space-xl);
    }

    .page-head h1 {
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: #ffffff;
        margin-bottom: var(--space-sm);
        line-height: 1.25;
    }

    .page-head p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 1rem;
        max-width: 480px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .hero-line {
        width: 56px;
        height: 3px;
        background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary-soft));
        border-radius: 3px;
        margin: var(--space-lg) auto 0;
    }

    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: var(--space-lg);
    }

    .post-card {
        display: flex;
        background: #ffffff;
        border-radius: var(--radius-md);
        padding: var(--space-lg);
        box-shadow: var(--shadow-sm);
        transition: transform var(--transition-base), box-shadow var(--transition-base);
        overflow: hidden;
    }
    .post-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    .post-card-accent {
        flex-shrink: 0;
        width: 3px;
        border-radius: 2px;
        margin-right: var(--space-lg);
        align-self: stretch;
    }

    .post-card-body {
        flex: 1;
        min-width: 0;
    }

    .post-card-meta-top {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin-bottom: 6px;
        font-size: 0.85rem;
    }

    .post-card-date {
        color: var(--color-text-faint);
        font-size: 0.82rem;
    }

    .post-card-dot {
        color: var(--color-border);
        font-weight: 700;
    }

    .post-card-label {
        color: var(--color-primary);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .post-card-title {
        font-size: 1.25rem;
        font-weight: 650;
        line-height: 1.45;
        margin-bottom: var(--space-sm);
    }
    .post-card-title a {
        color: var(--color-text);
        text-decoration: none;
        transition: color var(--transition-base);
    }
    .post-card-title a:hover {
        color: var(--color-primary);
    }

    .post-card-excerpt {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: var(--space-md);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-card-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--color-primary);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: gap var(--transition-base), color var(--transition-base);
    }
    .post-card-link:hover {
        color: var(--color-primary-dark);
        gap: 8px;
    }

    .empty-state {
        text-align: center;
        padding: var(--space-2xl) var(--space-lg);
        background: #ffffff;
        border-radius: var(--radius-md);
        color: var(--color-text-muted);
        box-shadow: var(--shadow-sm);
    }
    .empty-state h2 {
        font-size: 1.3rem;
        color: var(--color-text);
        margin-bottom: var(--space-sm);
    }
    .empty-state code {
        background: var(--color-bg-soft);
        padding: 2px 7px;
        border-radius: var(--space-xs);
        font-size: 0.88em;
    }

    /* 平板 */
    @media screen and (max-width: 1024px) {
        main {
            padding: var(--space-lg) var(--space-md) var(--space-xl);
        }
        .page-head h1 {
            font-size: 1.9rem;
        }
        .post-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: var(--space-md);
        }
    }

    /* 移动端 */
    @media screen and (max-width: 600px) {
        main {
            padding: var(--space-md) var(--space-md) var(--space-lg);
        }
        .page-head {
            padding: var(--space-sm) 0 var(--space-lg);
        }
        .page-head h1 {
            font-size: 1.6rem;
        }
        .page-head p {
            font-size: 0.92rem;
        }
        .post-grid {
            grid-template-columns: 1fr;
            gap: var(--space-md);
        }
        .post-card {
            padding: var(--space-md);
        }
        .post-card-accent {
            margin-right: var(--space-md);
        }
        .post-card-title {
            font-size: 1.15rem;
        }
    }
</style>
