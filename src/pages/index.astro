---
import BaseLayout from './../layouts/baseLayout.astro';
import quickLinks from './../config/fastLink';

const placeholderSvg = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg"/%3E';
//构建快速链接字符串
const quickLinksStr = quickLinks.map(link => `
    <link href="${link.link}">
        <img src="${link.icon}" alt="${link.name}" />
        <span>${link.name}</span>
    </link>
`).join('');
---
<BaseLayout title="阿卡夏图书馆——咒法学中文网">
    <main>
        <cover>
            <img src={placeholderSvg} alt="阿卡夏图书馆——咒法学中文网" data-vertical="./../../public/assets/verticalCover.png" data-horizontal="./../../public/assets/horizontalCover.png" />
        </cover>
        <content>
            <quickLinks set:html={quickLinksStr} />
        </content>
    </main>
</BaseLayout>
<style is:global>
    html, body {
        overflow: hidden;
    }
    @media screen and (max-width: 768px) {
        html, body {
            overflow: auto;
            overscroll-behavior: none;
        }
    }
</style>
<style>
    main {
        height: 100%;
        overflow: hidden;
        display: grid;
        grid-template-columns: 576px 1fr;
    }
    @media screen and (max-width: 768px) {
        main {
            height: auto;
            overflow: visible;
            grid-template-columns: 1fr;
        }
    }
    cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: relative;
    }
    cover img {
        display: block;
    }
    @media screen and (max-width: 768px) {
        cover {
            width: fit-content;
            height: auto;
        }
        cover img {
            width: 100vw;
            height: auto;
            object-fit: contain;
        }
    }
    content {
        display: grid;
        grid-template-rows: 80px 1fr;
    }
    @media screen and (max-width: 768px) {
        content {
            grid-template-rows: 80px auto;
        }
    }
    quickLinks {
        background-color: aliceblue;
    }
</style>

<script lang="ts">
    function main(){
        setCover();
        //在屏幕尺寸变化时候运行setCover函数
        window.addEventListener('resize', setCover);
    }
    function setCover(){
        // 查找所有img标签
        const imgs = document.querySelectorAll('img');
        // 遍历所有img标签 寻找带有data-horizontal和data-vertical属性的img标签
        imgs.forEach(img => {
            if(img.dataset.horizontal && img.dataset.vertical){
                // 如果有data-horizontal和data-vertical属性 则设置src为data-horizontal
                img.src = img.dataset.horizontal;
            }
        })
        // 判断是否为移动端 如果是移动端 则设置src为data-vertical 否则设置src为data-horizontal
        if(window.innerWidth < 768){
            imgs.forEach(img => {
                if(img.dataset.vertical){
                    img.src = img.dataset.vertical;
                }
            })
        }
    }
    main();
</script>