---
import BaseLayout from '../layouts/baseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const recentPosts = posts.slice(0, 4);
---
<BaseLayout title="阿卡夏图书馆——咒法学中文网">
    <main>
        <section class="hero">
            <div class="hero-cover">
                <img
                    src="/assets/horizontalCover.png"
                    alt="阿卡夏图书馆——咒法学中文网"
                    data-vertical="/assets/verticalCover.png"
                    data-horizontal="/assets/horizontalCover.png"
                />
            </div>
            <div class="hero-content">
                <h1 class="hero-title">阿卡夏图书馆</h1>
                <p class="hero-desc">咒法学（Hex Casting）中文资料站，收录教程、故事和施法研究。</p>
                <div class="hero-actions">
                    <a href="/posts/" class="hero-btn hero-btn-primary">浏览文章</a>
                    <a href="/posts/casting/" class="hero-btn hero-btn-ghost">入门指南</a>
                </div>
            </div>
        </section>

        <section class="recent">
            <div class="recent-head">
                <h2 class="recent-title">最近文章</h2>
                <a href="/posts/" class="recent-more">查看全部 <span aria-hidden="true">→</span></a>
            </div>
            <div class="post-grid">
                {
                    recentPosts.length > 0 ? (
                        recentPosts.map((post, index) => (
                            <article class="post-card">
                                <div class="post-card-accent" style={`background: hsl(${280 + index * 30}, 45%, 55%)`} />
                                <div class="post-card-body">
                                    <div class="post-card-meta-top">
                                        <time class="post-card-date">{post.data.date.toLocaleDateString('zh-CN')}</time>
                                        <span class="post-card-dot">·</span>
                                        <span class="post-card-label">文章</span>
                                    </div>
                                    <h3 class="post-card-title">
                                        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                                    </h3>
                                    {post.data.description && <p class="post-card-excerpt">{post.data.description}</p>}
                                </div>
                            </article>
                        ))
                    ) : (
                        <p class="empty">暂无文章</p>
                    )
                }
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    main {
        width: 100%;
        max-width: var(--container-max);
        margin: 0 auto;
        padding: var(--space-xl) var(--space-lg) var(--space-2xl);
        display: flex;
        flex-direction: column;
        gap: var(--space-2xl);
    }

    /* Hero 区：桌面左右布局，移动端纵向 */
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: var(--space-xl);
        align-items: center;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: var(--radius-lg);
        padding: var(--space-xl);
        box-shadow: var(--shadow-md);
    }

    .hero-cover {
        width: 100%;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: rgba(0, 0, 0, 0.15);
    }

    .hero-cover img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
    }

    .hero-content {
        color: #ffffff;
    }

    .hero-title {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: var(--space-sm);
        line-height: 1.25;
    }

    .hero-desc {
        color: rgba(255, 255, 255, 0.88);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: var(--space-lg);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform var(--transition-base), background var(--transition-base), color var(--transition-base);
        cursor: pointer;
    }

    .hero-btn-primary {
        background: #ffffff;
        color: var(--color-primary);
    }
    .hero-btn-primary:hover {
        background: var(--color-primary-soft);
        transform: translateY(-1px);
    }

    .hero-btn-ghost {
        background: transparent;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.6);
    }
    .hero-btn-ghost:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: #ffffff;
        transform: translateY(-1px);
    }

    /* 最近文章区 */
    .recent {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
    }

    .recent-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-md);
        flex-wrap: wrap;
    }

    .recent-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.03em;
    }

    .recent-more {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 500;
        transition: color var(--transition-base), gap var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .recent-more:hover {
        color: #ffffff;
        gap: 8px;
    }

    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--space-md);
    }

    .post-card {
        display: flex;
        background: #ffffff;
        border-radius: var(--radius-md);
        padding: var(--space-lg);
        box-shadow: var(--shadow-sm);
        transition: transform var(--transition-base), box-shadow var(--transition-base);
        overflow: hidden;
    }
    .post-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .post-card-accent {
        flex-shrink: 0;
        width: 3px;
        border-radius: 2px;
        margin-right: var(--space-md);
        align-self: stretch;
    }

    .post-card-body {
        flex: 1;
        min-width: 0;
    }

    .post-card-meta-top {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin-bottom: 6px;
    }

    .post-card-date {
        color: var(--color-text-faint);
        font-size: 0.8rem;
    }

    .post-card-dot {
        color: var(--color-border);
        font-weight: 700;
    }

    .post-card-label {
        color: var(--color-primary);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .post-card-title {
        font-size: 1.08rem;
        font-weight: 600;
        line-height: 1.45;
        margin-bottom: 6px;
    }
    .post-card-title a {
        color: var(--color-text);
        text-decoration: none;
        transition: color var(--transition-base);
    }
    .post-card-title a:hover {
        color: var(--color-primary);
    }

    .post-card-excerpt {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .empty {
        color: rgba(255, 255, 255, 0.85);
        text-align: center;
        padding: var(--space-xl) 0;
        grid-column: 1 / -1;
        background: rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-md);
    }

    /* 平板 */
    @media screen and (max-width: 1024px) {
        main {
            padding: var(--space-lg) var(--space-md) var(--space-xl);
            gap: var(--space-xl);
        }
        .hero {
            grid-template-columns: 1fr;
            padding: var(--space-lg);
            gap: var(--space-lg);
        }
        .hero-cover {
            max-width: 480px;
            margin: 0 auto;
        }
        .hero-title {
            font-size: 1.75rem;
        }
        .hero-content {
            text-align: center;
        }
        .hero-actions {
            justify-content: center;
        }
    }

    /* 移动端 */
    @media screen and (max-width: 600px) {
        main {
            padding: var(--space-md) var(--space-md) var(--space-lg);
            gap: var(--space-lg);
        }
        .hero {
            padding: var(--space-md);
            border-radius: var(--radius-md);
        }
        .hero-title {
            font-size: 1.5rem;
        }
        .hero-desc {
            font-size: 0.95rem;
        }
        .hero-btn {
            flex: 1;
            min-width: 0;
            padding: 10px 16px;
        }
        .recent-title {
            font-size: 1.2rem;
        }
        .post-grid {
            grid-template-columns: 1fr;
            gap: var(--space-sm);
        }
        .post-card {
            padding: var(--space-md);
        }
    }
</style>

<script>
    function setCover() {
        const imgs = document.querySelectorAll<HTMLImageElement>('img[data-horizontal][data-vertical]');
        const isMobile = window.innerWidth < 768;
        imgs.forEach((img) => {
            img.src = isMobile ? img.dataset.vertical! : img.dataset.horizontal!;
        });
    }

    setCover();
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(setCover, 150);
    });
</script>
