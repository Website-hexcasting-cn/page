---
import BaseLayout from '../layouts/baseLayout.astro';
---
<BaseLayout title="咒法图案检索——阿卡夏图书馆">
    <main class="tool-main">
        <div class="tool-card">
            <header class="tool-header">
                <h1 class="tool-title">咒法图案检索</h1>
                <p class="tool-desc">
                    从 <a href="https://pypi.org/project/HexBug-data/" target="_blank" rel="noopener">PyPI HexBug-data</a>
                    索引的图案注册名与多语言译名。支持 <strong>注册名 → 译名</strong> 与
                    <strong>译名 → 注册名</strong> 双向查找，也可按签名搜索，并可渲染图案、复制格式。
                </p>
            </header>

            <div class="tool-bar">
                <input id="search" type="search" class="search-input" autocomplete="off" spellcheck="false"
                    placeholder="注册名、译名或签名（如 get_caster、意识之精思、qqaeaae）…" />
                <select id="lang" class="lang-select" title="显示语言"></select>
                <select id="mod-filter" class="lang-select" title="按模组过滤"><option value="">全部模组</option></select>
                <button id="refresh" class="refresh-btn" type="button" title="从 PyPI 实时拉取最新数据">从 PyPI 刷新</button>
            </div>

            <div id="status" class="status-bar">
                <span id="status-text">加载数据…</span>
                <span id="refresh-progress" class="refresh-progress" hidden></span>
            </div>

            <div class="workspace">
                <div id="results" class="results" aria-live="polite"></div>
                <aside id="detail" class="detail">
                    <div class="detail-sheet" id="detail-sheet">
                        <button id="detail-close" class="detail-close" type="button">关闭</button>
                        <div id="detail-body"></div>
                    </div>
                </aside>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .tool-main {
        max-width: var(--container-max, 1200px);
        margin: 0 auto;
        padding: var(--space-xl) var(--space-lg) var(--space-2xl);
        width: 100%;
    }
    .tool-card {
        background: #ffffff;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: var(--space-xl);
    }
    .tool-header { margin-bottom: var(--space-lg); }
    .tool-title { font-size: 1.7rem; color: var(--color-primary); margin-bottom: var(--space-sm); }
    .tool-desc { color: var(--color-text-muted); line-height: 1.7; font-size: 0.95rem; }
    .tool-desc a { color: var(--color-primary); }

    .tool-bar { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-md); }
    .search-input {
        flex: 1 1 320px;
        padding: 11px 14px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: border-color var(--transition-base), box-shadow var(--transition-base);
    }
    .search-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(145, 75, 151, 0.15); }
    .lang-select {
        padding: 10px 12px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-bg-soft);
        font-size: 0.9rem;
        color: var(--color-text);
        cursor: pointer;
    }
    .refresh-btn {
        padding: 10px 16px;
        border: none;
        border-radius: var(--radius-sm);
        background: var(--color-primary);
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background var(--transition-base), transform var(--transition-base);
    }
    .refresh-btn:hover { background: var(--color-primary-dark); }
    .refresh-btn:disabled { opacity: 0.6; cursor: wait; }

    .status-bar {
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-sm);
        font-size: 0.85rem; color: var(--color-text-faint);
        padding: 8px 2px 14px;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: var(--space-lg);
    }
    .refresh-progress { color: var(--color-primary); font-weight: 600; }

    .workspace {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
        gap: var(--space-lg);
        align-items: start;
    }
    .results { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-md); align-content: start; }
    .result-empty { grid-column: 1 / -1; text-align: center; color: var(--color-text-muted); padding: var(--space-xl) 0; }

    .p-card {
        display: flex; align-items: center; gap: var(--space-md);
        width: 100%;
        font: inherit;
        color: inherit;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: var(--space-md);
        cursor: pointer;
        text-align: left;
        transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    }
    .p-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); border-color: var(--color-primary-light); }
    .p-card.is-active { border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(145, 75, 151, 0.2); }
    .p-svg { flex-shrink: 0; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: var(--radius-sm); }
    .p-svg svg { max-width: 100%; height: auto; }
    .p-info { flex: 1; min-width: 0; }
    .p-name { font-weight: 600; font-size: 0.95rem; color: var(--color-text); line-height: 1.4; }
    .p-id { font-family: monospace; font-size: 0.78rem; color: var(--color-primary); word-break: break-all; }
    .p-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .p-tag {
        font-size: 0.7rem; padding: 1px 7px; border-radius: 999px;
        background: rgba(145, 75, 151, 0.12); color: var(--color-primary-dark);
    }
    .p-desc {
        font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.55;
        margin-top: 5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .detail {
        position: sticky;
        top: 84px;
        max-height: calc(100vh - 100px);
        overflow: auto;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: var(--space-lg);
    }
    .detail-empty { color: var(--color-text-muted); line-height: 1.7; font-size: 0.9rem; }
    .detail-close {
        display: none;
        margin-bottom: var(--space-sm);
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-border);
        background: #fff;
        color: var(--color-text);
        font-weight: 600;
        cursor: pointer;
    }
    .detail-head { display: flex; gap: var(--space-lg); align-items: flex-start; flex-wrap: wrap; }
    .detail-svg { background: #fff; border-radius: var(--radius-sm); padding: var(--space-md); display: inline-flex; }
    .detail-names { flex: 1; min-width: 160px; }
    .detail-other-names { margin-top: 8px; font-size: 0.8rem; color: var(--color-text-faint); line-height: 1.8; }
    .detail-other-name { cursor: help; }
    .detail-name-sep { margin: 0 2px; }
    .detail-copy { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
    .copy-btn {
        padding: 8px 14px; border-radius: var(--radius-sm); border: 1px solid var(--color-primary);
        background: #fff; color: var(--color-primary); font-size: 0.85rem; cursor: pointer; font-weight: 600;
        transition: background var(--transition-base), color var(--transition-base);
    }
    .copy-btn:hover { background: var(--color-primary); color: #fff; }
    .copy-btn.copied { background: #2e7d32; border-color: #2e7d32; color: #fff; }

    .detail-desc { margin-top: var(--space-lg); border-top: 1px solid var(--color-border); padding-top: var(--space-md); }
    .detail-desc-head { font-weight: 700; color: var(--color-primary); margin-bottom: var(--space-sm); font-size: 0.95rem; }
    .detail-desc-note { font-size: 0.75rem; color: var(--color-text-faint); font-weight: 500; margin-left: 6px; }
    .detail-desc-title { font-weight: 600; color: var(--color-text); margin-bottom: 4px; }
    .detail-desc-text { color: var(--color-text-muted); line-height: 1.8; font-size: 0.9rem; white-space: pre-line; }
    .detail-desc-missing { color: var(--color-text-faint); font-size: 0.9rem; }

    @media screen and (max-width: 800px) {
        .tool-main { padding: var(--space-md); }
        .tool-card { padding: var(--space-lg) var(--space-md); }
        .tool-bar > * { flex: 1 1 100%; }
        .workspace { display: block; }
        .detail {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 200;
            max-height: none;
            border: none;
            border-radius: 0;
            background: rgba(20, 10, 24, 0.45);
            padding: 0;
            overflow: hidden;
        }
        .detail.is-open { display: block; }
        .detail.is-open .detail-sheet {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            max-height: 86vh;
            overflow: auto;
            background: #fff;
            border-radius: 16px 16px 0 0;
            padding: var(--space-lg) var(--space-md) calc(var(--space-lg) + env(safe-area-inset-bottom));
        }
        .detail-close { display: inline-flex; }
    }
</style>

<script>
    import { patternToSvg } from '../lib/iotaRender';
    import {
        getPatternPackages,
        fetchLatestPatternRelease,
    } from '../lib/hexdocData';

    // ── 常量 ─────────────────────────────────────────────
    const HEX_DIR_NAMES = ['NORTH_EAST', 'EAST', 'SOUTH_EAST', 'SOUTH_WEST', 'WEST', 'NORTH_WEST'];
    const ANGLE_CHARS = ['w', 'e', 'd', 's', 'a', 'q'];
    const LANG_LABELS: Record<string, string> = {
        en_us: 'English', zh_cn: '简体中文', zh_tw: '繁體中文', ja_jp: '日本語', ko_kr: '한국어',
        ru_ru: 'Русский', de_de: 'Deutsch', fr_fr: 'Français', es_es: 'Español', es_mx: 'Español (MX)',
        pt_br: 'Português', it_it: 'Italiano', pl_pl: 'Polski', sv_se: 'Svenska', no_no: 'Norsk',
        fi_fi: 'Suomi', uk_ua: 'Українська', en_pt: 'Pirate English',
    };
    const langLabel = (l: string) => LANG_LABELS[l] ?? l;
    const EMPTY_HINT = '输入关键词，或选择一个模组浏览。';
    const DETAIL_HINT = '点选一个图案查看译名、手册介绍和复制格式。';

    // ── 状态 ─────────────────────────────────────────────
    type Pattern = {
        id: string; ns: string | null; modid: string; pkg: string;
        startDir: number; angles: number[]; names: Record<string, string>;
        category?: string;
        desc?: Record<string, { title: string; text: string }>;
    };

    /** 注册名（带各自 mod 的命名空间） */
    const regName = (p: Pattern) => (p.ns ? `${p.ns}:${p.id}` : p.id);
    let patterns: Pattern[] = [];
    let meta = { updatedAt: '', total: 0, packages: 0, langs: [] as string[], withDesc: 0 };
    let live = false;
    let lang = 'zh_cn';
    let selectedId = '';
    /** 静态数据里的手册介绍，PyPI 刷新后按注册名补回 */
    const descByReg = new Map<string, { desc?: Pattern['desc']; category?: string }>();

    const $ = (id: string) => document.getElementById(id)!;
    const searchEl = $('search') as HTMLInputElement;
    const langEl = $('lang') as HTMLSelectElement;
    const modEl = $('mod-filter') as HTMLSelectElement;
    const refreshBtn = $('refresh') as HTMLButtonElement;
    const statusText = $('status-text');
    const refreshProgress = $('refresh-progress');
    const resultsEl = $('results');
    const detailEl = $('detail');
    const detailBody = $('detail-body');

    const initial = new URLSearchParams(location.search);
    if (initial.get('q')) searchEl.value = initial.get('q')!;
    if (initial.get('lang')) lang = initial.get('lang')!;
    selectedId = initial.get('id') ?? '';
    const initialMod = initial.get('mod') ?? '';
    let appliedInitialMod = false;

    // ── 工具 ─────────────────────────────────────────────
    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    const patternSvg = (p: Pattern, size: number) =>
        patternToSvg(p.startDir, p.angles, { size, grid: true }).svg;

    const displayName = (p: Pattern) =>
        p.names[lang] ?? p.names['zh_cn'] ?? p.names['en_us'] ?? Object.values(p.names)[0] ?? p.id;

    const angleChar = (a: number) => ANGLE_CHARS[((a % 6) + 6) % 6] ?? '';
    const dirName = (p: Pattern) => HEX_DIR_NAMES[((p.startDir % 6) + 6) % 6] ?? 'NORTH_EAST';
    const signature = (p: Pattern) => p.angles.map(angleChar).join('');
    const signatureWrapped = (p: Pattern) => `{${dirName(p)},${signature(p)}}`;

    /** 手册介绍：当前语言 → zh_cn → en_us → 任一语言 */
    const bookDesc = (p: Pattern) => {
        if (!p.desc) return null;
        const order = [lang, 'zh_cn', 'en_us', ...Object.keys(p.desc)];
        for (const l of order) {
            const d = p.desc[l];
            if (d && (d.title || d.text)) return { ...d, lang: l };
        }
        return null;
    };

    const iotaPortable = (p: Pattern) => `iota:pattern${signatureWrapped(p)}`;

    /** 越小越靠前。完全相等 > 前缀 > 包含；当前语言译名和注册名优先于其它语言与正文。 */
    function matchScore(p: Pattern, q: string): number {
        let best = Infinity;
        const consider = (value: string, base: number) => {
            if (!value) return;
            const v = value.toLowerCase();
            if (v === q) best = Math.min(best, base);
            else if (v.startsWith(q)) best = Math.min(best, base + 10);
            else if (v.includes(q)) best = Math.min(best, base + 20);
        };
        consider(regName(p), 0);
        consider(p.id, 0);
        consider(p.names[lang] ?? '', 0);
        consider(signature(p), 0);
        consider(signatureWrapped(p), 0);
        consider(iotaPortable(p), 0);
        for (const [l, name] of Object.entries(p.names)) {
            if (l !== lang) consider(name, 30);
        }
        const desc = bookDesc(p);
        if (desc) {
            consider(desc.title, 60);
            if (desc.text && desc.text.toLowerCase().includes(q)) best = Math.min(best, 90);
        }
        return best;
    }

    function rememberStatic(list: Pattern[]) {
        descByReg.clear();
        for (const p of list) {
            if (p.desc || p.category) descByReg.set(regName(p), { desc: p.desc, category: p.category });
        }
    }

    function applyStaticDesc(list: Pattern[]) {
        for (const p of list) {
            const prev = descByReg.get(regName(p));
            if (!prev) continue;
            if (prev.desc) p.desc = prev.desc;
            if (prev.category) p.category = prev.category;
        }
    }

    let suppressUrl = false;
    function writeUrl() {
        if (suppressUrl) return;
        const u = new URL(location.href);
        const set = (k: string, v: string) => { if (v) u.searchParams.set(k, v); else u.searchParams.delete(k); };
        set('q', searchEl.value.trim());
        set('mod', modEl.value);
        set('lang', lang);
        set('id', selectedId);
        const next = u.pathname + u.search;
        if (next !== location.pathname + location.search) history.replaceState(null, '', next);
    }

    // ── 加载静态数据 ─────────────────────────────────────
    async function loadStatic() {
        try {
            const [pats, m] = await Promise.all([
                fetch('/pattern-data/patterns.json').then((r) => r.json()),
                fetch('/pattern-data/meta.json').then((r) => r.json()),
            ]);
            patterns = pats;
            meta = m;
            live = false;
            rememberStatic(patterns);
            afterData('静态数据');
        } catch (e) {
            statusText.textContent = `静态数据加载失败：${(e as Error).message}`;
        }
    }

    // ── 从 PyPI 实时刷新 ─────────────────────────────────
    async function refreshFromPyPI() {
        refreshBtn.disabled = true;
        try {
            const deps = await getPatternPackages();
            const prevByPkg = new Map<string, Pattern[]>();
            for (const p of patterns) {
                const list = prevByPkg.get(p.pkg);
                if (list) list.push(p);
                else prevByPkg.set(p.pkg, [p]);
            }
            const all: Pattern[] = [];
            const warnings: string[] = [];
            let done = 0;
            const total = deps.length;
            statusText.textContent = `从 PyPI 拉取最新版：0/${total}`;
            refreshProgress.hidden = false;
            for (const dep of deps) {
                try {
                    const { patterns: pats, version, skipped } = await fetchLatestPatternRelease(dep, async (url) => {
                        const res = await fetch(url, { cache: 'no-store' });
                        if (!res.ok) throw new Error(`HTTP ${res.status} ${url}`);
                        return res.arrayBuffer();
                    });
                    all.push(...pats);
                    if (skipped?.length) warnings.push(`${dep}: 最新版 ${skipped[0]} 的 wheel 没有图案表，改用 ${version}`);
                } catch (e) {
                    const prev = prevByPkg.get(dep);
                    if (prev?.length) all.push(...prev);
                    warnings.push(`${dep}: ${(e as Error).message}`);
                }
                done++;
                statusText.textContent = `从 PyPI 拉取最新版：${done}/${total}`;
                await new Promise((r) => setTimeout(r, 50));
            }
            all.sort((a, b) => a.pkg.localeCompare(b.pkg) || a.id.localeCompare(b.id));
            applyStaticDesc(all);
            patterns = all;
            meta = {
                updatedAt: new Date().toISOString(),
                total: all.length,
                packages: deps.length,
                langs: [...new Set(all.flatMap((p) => Object.keys(p.names)))].sort(),
                withDesc: all.filter((p) => p.desc).length,
            };
            live = true;
            refreshProgress.hidden = true;
            statusText.innerHTML = `已从 PyPI 实时刷新：${all.length.toLocaleString()} 个图案 / ${deps.length} 个包` +
                (warnings.length ? `（${warnings.length} 个包失败：${escapeHtml(warnings.join('；'))}）` : '');
            afterData('实时数据');
        } catch (e) {
            statusText.textContent = `刷新失败（可能被跨域策略拦截）：${(e as Error).message}`;
            refreshProgress.hidden = true;
        } finally {
            refreshBtn.disabled = false;
        }
    }

    // ── 渲染 ─────────────────────────────────────────────
    function afterData(source: string) {
        const prevLang = lang;
        langEl.innerHTML = meta.langs
            .map((l) => `<option value="${l}" ${l === prevLang ? 'selected' : ''}>${langLabel(l)}</option>`)
            .join('');
        if (meta.langs.includes(lang)) langEl.value = lang;
        else { lang = meta.langs.includes('zh_cn') ? 'zh_cn' : meta.langs[0] ?? 'en_us'; langEl.value = lang; }
        const mods = [...new Set(patterns.map((p) => p.modid))].sort();
        const prevMod = appliedInitialMod ? modEl.value : initialMod;
        appliedInitialMod = true;
        modEl.innerHTML = '<option value="">全部模组</option>' + mods
            .map((m) => `<option value="${m}" ${m === prevMod ? 'selected' : ''}>${m}</option>`)
            .join('');
        const descN = patterns.filter((p) => p.desc).length;
        statusText.textContent = `${source}：${patterns.length.toLocaleString()} 个图案 · ${meta.packages} 个包 · ${meta.langs.length} 种语言` +
            (descN ? ` · ${descN.toLocaleString()} 个有手册介绍` : '') +
            ` · 更新于 ${new Date(meta.updatedAt).toLocaleString('zh-CN')}` +
            (live ? '（名称与签名为实时数据，手册介绍沿用站内静态数据；刷新页面恢复）' : '');
        render();
        writeUrl();
    }

    function render() {
        const q = searchEl.value.trim().toLowerCase();
        const mod = modEl.value;
        if (!q && !mod) {
            resultsEl.innerHTML = `<div class="result-empty">${EMPTY_HINT}</div>`;
            refreshDetail();
            return;
        }
        const ranked: { p: Pattern; s: number }[] = [];
        for (const p of patterns) {
            if (mod && p.modid !== mod) continue;
            const s = q ? matchScore(p, q) : 0;
            if (s === Infinity) continue;
            ranked.push({ p, s });
        }
        ranked.sort((a, b) => a.s - b.s || regName(a.p).localeCompare(regName(b.p)));
        const shown = ranked.slice(0, 200);
        if (!shown.length) {
            resultsEl.innerHTML = '<div class="result-empty">没有匹配的图案。</div>';
            refreshDetail();
            return;
        }
        const frag = document.createDocumentFragment();
        for (const { p } of shown) {
            const card = document.createElement('button');
            card.type = 'button';
            card.className = 'p-card' + (regName(p) === selectedId ? ' is-active' : '');
            card.dataset.id = regName(p);
            const desc = bookDesc(p);
            const excerpt = desc?.text ? (desc.text.length > 72 ? desc.text.slice(0, 72) + '…' : desc.text) : '';
            card.innerHTML = `
                <div class="p-svg">${patternSvg(p, 14)}</div>
                <div class="p-info">
                    <div class="p-name">${escapeHtml(displayName(p))}</div>
                    <div class="p-id">${escapeHtml(regName(p))}</div>
                    ${excerpt ? `<div class="p-desc">${escapeHtml(excerpt)}</div>` : ''}
                    <div class="p-meta"><span class="p-tag">${escapeHtml(p.modid)}</span>${p.category ? `<span class="p-tag">${escapeHtml(p.category)}</span>` : ''}</div>
                </div>`;
            card.addEventListener('click', () => selectPattern(p));
            frag.appendChild(card);
        }
        resultsEl.innerHTML = '';
        resultsEl.appendChild(frag);
        if (ranked.length > shown.length) {
            const more = document.createElement('div');
            more.className = 'result-empty';
            more.textContent = `仅显示前 200 条（共 ${ranked.length} 条匹配），请细化搜索关键词。`;
            resultsEl.appendChild(more);
        }
        refreshDetail();
    }

    function selectPattern(p: Pattern) {
        selectedId = regName(p);
        for (const el of resultsEl.querySelectorAll<HTMLElement>('.p-card')) {
            el.classList.toggle('is-active', el.dataset.id === selectedId);
        }
        detailEl.classList.add('is-open');
        fillDetail(p);
        writeUrl();
    }

    function closeDetail() {
        selectedId = '';
        detailEl.classList.remove('is-open');
        for (const el of resultsEl.querySelectorAll('.is-active')) el.classList.remove('is-active');
        detailBody.innerHTML = `<div class="detail-empty">${DETAIL_HINT}</div>`;
        writeUrl();
    }

    function refreshDetail() {
        if (!selectedId) {
            detailEl.classList.remove('is-open');
            detailBody.innerHTML = `<div class="detail-empty">${DETAIL_HINT}</div>`;
            return;
        }
        const p = patterns.find((x) => regName(x) === selectedId);
        if (!p) {
            detailEl.classList.add('is-open');
            detailBody.innerHTML = '<div class="detail-empty">链接中的图案不在当前数据里。</div>';
            return;
        }
        detailEl.classList.add('is-open');
        fillDetail(p);
    }

    function fillDetail(p: Pattern) {
        const curName = displayName(p);
        const otherNames = Object.entries(p.names)
            .filter(([, n]) => n !== curName)
            .map(([l, n]) => `<span class="detail-other-name" title="${escapeHtml(langLabel(l))}">${escapeHtml(n)}</span>`)
            .join('<span class="detail-name-sep"> · </span>');
        const desc = bookDesc(p);
        const descNote = desc && desc.lang !== lang
            ? `<span class="detail-desc-note">以下为${escapeHtml(langLabel(desc.lang))}</span>` : '';
        const descBlock = desc ? `
            <div class="detail-desc"><div class="detail-desc-head">手册介绍${descNote}</div>
                ${desc.title ? `<div class="detail-desc-title">${escapeHtml(desc.title)}</div>` : ''}
                ${desc.text ? `<div class="detail-desc-text">${escapeHtml(desc.text)}</div>` : '<div class="detail-desc-missing">暂无手册介绍</div>'}
            </div>` : `
            <div class="detail-desc"><div class="detail-desc-head">手册介绍</div>
                <div class="detail-desc-missing">暂无手册介绍</div>
            </div>`;
        const copies: [string, string][] = [
            ['复制注册名', regName(p)],
            ['复制签名', signatureWrapped(p)],
            ['复制 iota 便携语法', iotaPortable(p)],
        ];
        detailBody.innerHTML = `
            <div class="detail-head">
                <div class="detail-svg">${patternSvg(p, 22)}</div>
                <div class="detail-names">
                    <div class="p-name" style="font-size:1.1rem;">${escapeHtml(curName)}</div>
                    <div class="p-id" style="font-size:0.9rem;">${escapeHtml(regName(p))}</div>
                    <div class="p-meta"><span class="p-tag">${escapeHtml(p.modid)}</span>${p.category ? `<span class="p-tag">${escapeHtml(p.category)}</span>` : ''}</div>
                    ${otherNames ? `<div class="detail-other-names">${otherNames}</div>` : ''}
                </div>
            </div>
            ${descBlock}
            <div class="detail-copy">
                ${copies.map(([label, value]) => `<button class="copy-btn" type="button" data-copy="${escapeHtml(value)}">${label}</button>`).join('')}
            </div>`;
        detailBody.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(btn.dataset.copy!);
                    const old = btn.textContent;
                    btn.textContent = '已复制 ✓';
                    btn.classList.add('copied');
                    setTimeout(() => { btn.textContent = old; btn.classList.remove('copied'); }, 1200);
                } catch { btn.textContent = '复制失败'; }
            });
        });
    }

    // ── 事件 ─────────────────────────────────────────────
    let debounce: number | undefined;
    searchEl.addEventListener('input', () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => { render(); writeUrl(); }, 120);
    });
    langEl.addEventListener('change', () => { lang = langEl.value; render(); writeUrl(); });
    modEl.addEventListener('change', () => { render(); writeUrl(); });
    refreshBtn.addEventListener('click', refreshFromPyPI);
    $('detail-close').addEventListener('click', closeDetail);
    detailEl.addEventListener('click', (e) => {
        if (e.target === detailEl) closeDetail();
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && selectedId) closeDetail();
    });
    window.addEventListener('popstate', () => {
        suppressUrl = true;
        const p = new URLSearchParams(location.search);
        searchEl.value = p.get('q') ?? '';
        const nextLang = p.get('lang');
        if (nextLang && [...langEl.options].some((o) => o.value === nextLang)) {
            lang = nextLang;
            langEl.value = nextLang;
        }
        modEl.value = p.get('mod') ?? '';
        selectedId = p.get('id') ?? '';
        render();
        suppressUrl = false;
    });

    loadStatic();
</script>
